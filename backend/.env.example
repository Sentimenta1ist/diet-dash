# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://dietdash:your_password@postgres_host:5432/dietdash

# JWT secret — use a long random string (e.g. openssl rand -base64 48)
JWT_SECRET=change_this_to_a_long_random_secret

# Mailtrap credentials (for confirmation/reset emails)
# Get from: https://mailtrap.io → API → API Token
MAILTRAP_API_TOKEN=your_mailtrap_api_token

# SMTP password (used as fallback / legacy mail sender)
MAIL_PASSWORD=your_mail_password

# Port the backend listens on inside the container
PORT=5000

# Domain shown in confirmation email links (no trailing slash)
DOMAIN=diet-dash.qear.net
