# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:secret@localhost:5432/dietdash

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens (HS256). Must be long and random.
# Example: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ─── Email ────────────────────────────────────────────────────────────────────
# Gmail App Password for SMTP fallback (account: diet.dash.agent@gmail.com)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=gmail-app-password-here

# MailTrap transactional email API token (primary email provider)
# Get from: https://mailtrap.io → API Tokens
MAILTRAP_API_TOKEN=your-mailtrap-api-token-here

# ─── App ──────────────────────────────────────────────────────────────────────
# Port the backend listens on inside the container
PORT=5000

# Public domain name — used in email confirmation/reset links
# Example: diet-dash.com
DOMAIN=diet-dash.com

# Optional: create a demo PRO account test@dietdash.com with this password on startup
# TEST_USER_PASSWORD=

# ─── PostgreSQL (for docker-compose) ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=dietdash
